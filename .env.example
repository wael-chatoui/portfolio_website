# Optional. Defaults to the active Vercel domain until a custom domain is configured.
NEXT_PUBLIC_SITE_URL=https://wael-chatoui.vercel.app

# Server only. Configure in the deployment environment, never commit a real key.
RESEND_API_KEY=
# Optional verified sender. The default Resend sender only works for permitted recipients.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
# Studio privé : valeurs serveur uniquement, ne pas utiliser ces exemples en production.
STUDIO_DATABASE_URL=
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=
# Adresse de connexion, facultative : par défaut l'adresse publique du portfolio.
STUDIO_EMAIL=
